# Unit cube for ERC landmark textures.
# All four vertical faces use the same upright UV orientation.
# Top and bottom sample a white point near the texture's upper-left corner.
o LandmarkBox_Upright
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
vt 1.0 0.0
vt 0.0 0.0
vt 0.0 1.0
vt 1.0 1.0
vt 0.02 0.98
vn  0  0  1
vn  1  0  0
vn  0  0 -1
vn -1  0  0
vn  0  1  0
vn  0 -1  0
# Front (+Z)
f 1/1/1 2/2/1 3/3/1 4/4/1
# Right (+X)
f 2/1/2 6/2/2 7/3/2 3/4/2
# Back (-Z)
f 6/1/3 5/2/3 8/3/3 7/4/3
# Left (-X)
f 5/1/4 1/2/4 4/3/4 8/4/4
# Top (+Y), blank
f 4/5/5 3/5/5 7/5/5 8/5/5
# Bottom (-Y), blank
f 5/5/6 6/5/6 2/5/6 1/5/6
